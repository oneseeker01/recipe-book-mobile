{
  "expo": {
    "name": "Recipe Book",
    "slug": "recipe-book-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/recipebook.png",
    "scheme": "recipebook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolmobileprojects.recipebookmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A12D2A",
        "foregroundImage": "./assets/images/recipebook.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.schoolmobileprojects.recipebookmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/recipebook.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/recipebook.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cc91a9b-a489-46b8-af81-0155a6f9e540"
      }
    },
    "owner": "school-mobile-projects",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9cc91a9b-a489-46b8-af81-0155a6f9e540",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
